    "start": "node dist/index.js"
  },
  "dependencies": {
    "bullmq": "^6.3.17",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
