generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}


model Project {
  id            String    @id @default(uuid())
  key           String    @unique
  name          String
  description   String?
  targetDate    DateTime? @db.Date
  archivedAt    DateTime?
  ticketCounter Int       @default(0)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tickets       Ticket[]

  @@index([createdById])
}

model Ticket {
  id          String         @id @default(uuid())
  number      Int // per-project sequence: WEB-1, WEB-2, ...
  title       String
  description String?
  status      TicketStatus   @default(BACKLOG)
  priority    TicketPriority @default(MEDIUM)
  storyPoints Int?
  dueDate     DateTime?      @db.Date
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    Comment[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([projectId, status])
  @@index([createdById])
}


model Comment {
  id          String   @id @default(uuid())
  body        String
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ticketId])
  @@index([createdById])
}